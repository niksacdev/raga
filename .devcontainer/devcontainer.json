// devcontainer.json for raga repo
{
  "name": "Raga Dev Container",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "settings": {
    "terminal.integrated.shell.linux": "/bin/bash"
  },
  "extensions": [
    "ms-python.python"
  ],
  "postCreateCommand": "git --version && python3 --version && pip3 --version"
}
